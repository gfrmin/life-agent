{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["entities", "format_version"],
  "properties": {
    "format_version": {"const": 1},
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "type", "span"],
        "properties": {
          "text": {"type": "string"},
          "type": {
            "type": "string",
            "enum": [
              "person",
              "organization",
              "location",
              "date",
              "money",
              "other"
            ]
          },
          "span": {
            "type": "object",
            "required": ["start", "end"],
            "properties": {
              "start": {"type": "integer", "minimum": 0},
              "end": {"type": "integer", "minimum": 0}
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
