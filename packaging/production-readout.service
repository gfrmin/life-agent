# life-agent production readout — the standing watch on the deployed typed arm
# (stage 0.3: run 14 carried two priced standing wrong rows to production; this is the
# readout that watches the live calibration stream for them — counts and ids, never
# corpus values). Install on whichever box carries the live stream — the repo names
# none; LIFE_AGENT_KB in that box's .env decides which stream is served:
#   ln -s "$PWD/packaging/production-readout.service" ~/.config/systemd/user/
#   ln -s "$PWD/packaging/production-readout.timer"   ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now production-readout.timer
# LIFE_AGENT_KB resolves at runtime from the repo .env via bin/production-readout — put it
# there, not in a unit override: a copied/overridden unit is free to drift and stops being
# this file. Report lands at $LIFE_AGENT_KB/calibration/readout.md. To watch more than one
# box's stream, append `--kb PATH` arguments (the readout unions them and reports each
# root's row count, so a dead root shows as `0 rows (EMPTY)` in the report itself).
[Unit]
Description=life-agent production readout (weekly watch on the deployed arm)

[Service]
Type=oneshot
ExecStart=%h/git/life-agent/bin/production-readout
