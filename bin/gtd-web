#!/usr/bin/env bash
# gtd-web — the GTD webapp: a direct-manipulation button surface over the event-sourced GTD store
# (a reach channel, like the Telegram bot). Sources .env (LIFE_AGENT_KB), then serves the page +
# a small JSON API that routes through tasks.commands / tasks.store. Binds 0.0.0.0 by default
# (firewalled host, reachable over Tailscale); no auth beyond the network boundary. Ctrl-C to stop.
#   gtd-web                                  # bind 0.0.0.0:8797 (defaults)
#   LIFE_AGENT_WEB_PORT=9000 gtd-web         # override the port
#   LIFE_AGENT_WEB_HOST=127.0.0.1 gtd-web    # localhost only
set -euo pipefail
# Resolve through symlinks (e.g. ~/.local/bin/gtd-web) so root is always the repo.
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
set -a; [ -f "$root/.env" ] && source "$root/.env"; set +a
exec uv run --project "$root" python -m life_agent.reach.web.server "$@"
