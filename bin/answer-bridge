#!/usr/bin/env bash
# answer-bridge — the life-agent capability bridge (move-3-design): a stateless JSON-over-HTTP
# service the answer-brain pi-mono body fetches for route/retrieve/extract/probe/utility.
# Sources .env (LIFE_AGENT_KB / PKM_CONFIG), then runs the service warm (one read-only catalogue
# handle + extraction client at boot). Localhost-bound; the owner profile + utility stay
# server-side. Ctrl-C to stop.
#   answer-bridge                                       # bind 127.0.0.1:8798 (defaults)
#   LIFE_AGENT_BRIDGE_PORT=8888 answer-bridge           # override the port
set -euo pipefail
# Resolve through symlinks (e.g. ~/.local/bin/answer-bridge) so root is always the repo.
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
set -a; [ -f "$root/.env" ] && source "$root/.env"; set +a
exec uv run --project "$root" python -m life_agent.bridge.server "$@"
