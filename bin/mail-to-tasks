#!/usr/bin/env bash
# mail-to-tasks — the timer/debug entrypoint for email→GTD (M2).
# Extracts grounded action items from new mail and auto-files them into the
# GTD inbox (life_agent.tasks, event-sourced); you triage in Telegram. Meant to
# run unattended from a systemd --user timer after mail ingest — by hand it's
# for debugging. Sources .env (LIFE_AGENT_KB / PKM_CONFIG / JARVIS_*), then runs
# in life-agent's env (pkm + life_agent are in-tree packages).
#   mail-to-tasks            # extract + file + notify (the default)
#   mail-to-tasks --dry-run  # preview grounded candidates, write nothing
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
set -a; [ -f "$root/.env" ] && source "$root/.env"; set +a
# The transforms run on the Anthropic seam (local Ollama deprecated 2026-08-17); the
# pkm client reads the SDK's env var, and a systemd --user timer has no shell env —
# resolve it from the keyring here, without ever printing it.
if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
  ANTHROPIC_API_KEY="$(secret-tool lookup service env key ANTHROPIC_API_KEY || true)"
  export ANTHROPIC_API_KEY
fi
exec uv run --project "$root" python "$root/scripts/mail_to_tasks.py" "$@"
