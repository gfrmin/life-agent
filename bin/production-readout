#!/usr/bin/env bash
# production-readout — the standing watch on the deployed typed arm (stage 0.3), as a
# wrapper like every other entrypoint here. Sources .env (LIFE_AGENT_KB), then runs the
# readout in life-agent's env. Meant to run unattended from a systemd --user timer
# (packaging/production-readout.timer); by hand it is a dry run of the weekly report.
#   production-readout                       # union $LIFE_AGENT_KB, write beside the stream
#   production-readout --kb A --kb B         # union two KB roots (the live stream accrues
#                                            # on whichever box served; this repo names none)
#   production-readout --since 2026-08-25    # widen or narrow the window
#
# This used to be `%h/git/life-agent/.venv/bin/python scripts/production_readout.py` in the
# unit itself, which (a) depended on a build artefact existing at a fixed path and (b) never
# sourced .env — so LIFE_AGENT_KB had to come from a unit override, which is exactly the
# drift trap packaging/jarvis.service's comment warns about.
set -euo pipefail
# Resolve through symlinks (e.g. ~/.local/bin/production-readout) so root is always the repo.
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
set -a; [ -f "$root/.env" ] && source "$root/.env"; set +a
exec uv run --project "$root" python "$root/scripts/production_readout.py" "$@"
