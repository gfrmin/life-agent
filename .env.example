# life-agent local config — copy to `.env` (gitignored) and set for your machine.
# NON-SECRET ONLY: paths and toggles. Secrets (ANTHROPIC_API_KEY, OPENAI_API_KEY, …)
# stay in your secret store (this project reads them via `secret-tool`) — never here.
#
# Load into the current shell when working on life-agent:
#     set -a; source .env; set +a
#
# Out-of-tree knowledge base (PII, run outputs). Default if unset: ~/.life-agent/kb
LIFE_AGENT_KB="$HOME/.life-agent/kb"

# Your pkm config.yaml. Default if unset: ~/.config/life-agent/pkm.yaml
PKM_CONFIG="$HOME/.config/pkm/config.yaml"

# Optional corpus roots used by build_corpus.sh / needle.sh (else default to $HOME/{...}):
# DOCS_SRC="$HOME/documents"
# NOTES_SRC="$HOME/notes"
# PARSED_SRC="$HOME/parsed"
