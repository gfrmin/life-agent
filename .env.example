# life-agent local config — copy to `.env` (gitignored) and set for your machine.
# Primarily NON-SECRET: paths and toggles. On a machine WITH a secret store
# (gnome-keyring), keep API keys there — this project reads them via `secret-tool`.
# Without one (the common case for a new user), `.env` is gitignored, so an
# ANTHROPIC_API_KEY here is a fine fallback: `secret()` checks the environment
# first, then the keyring (src/life_agent/core/llm.py).
#
# Load into the current shell when working on life-agent:
#     set -a; source .env; set +a
#
# Out-of-tree knowledge base (PII, run outputs). Default if unset: ~/.life-agent/kb
LIFE_AGENT_KB="$HOME/.life-agent/kb"

# Your pkm config.yaml. Default if unset: ~/.config/life-agent/pkm.yaml
# Copy config/pkm.example.yaml there and set its `root_dir` + pandoc version.
PKM_CONFIG="$HOME/.config/life-agent/pkm.yaml"

# API key for answer synthesis (bin/ask-live). Keyring is preferred where present;
# this env fallback is read if set. Building the sample corpus needs no key.
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional corpus roots used by build_corpus.sh / needle.sh (else default to $HOME/{...}):
# DOCS_SRC="$HOME/documents"
# NOTES_SRC="$HOME/notes"
# PARSED_SRC="$HOME/parsed"

# --- values deployed systemd --user services need at boot ------------------------
# Under `loginctl enable-linger`, a systemd --user service starts with a LOCKED
# gnome-keyring, so anything a linger-started unit needs must live HERE (chmod 600
# your .env), not in the keyring alone -- packaging/README.md documents the trap.
# Interactive tools still prefer the keyring; these are the boot-path copies.

# Owner's Telegram id (jarvis, gtd-web, daily-digest route to it).
# JARVIS_USER_ID="123456789"    # PII-OK: synthetic example id

# Telegram bot token (jarvis, daily-digest). The keyring fallback exists but is
# unavailable at boot under linger -- see above.
# TELEGRAM_TOKEN="1234567890:synthetic-example-token"

# Optional dead-man for the jarvis poll loop: when set, the loop pings this URL on
# every healthy poll, so a healthchecks-style monitor pages when polling stops
# (systemd "active (running)" cannot tell a polling jarvis from a hung one).
# JARVIS_HEARTBEAT_URL="https://hc.example.com/ping/00000000-0000-0000-0000-000000000000"

# Deliberation toggle for the ask path: absence and "1" mean ON; "0" is the only
# value that disables (src/life_agent/core/config.py).
# LIFE_AGENT_DELIBERATE="1"

# Bind addresses for the web surfaces (default 0.0.0.0 -- fine behind a firewall,
# wrong on a bare laptop). Set 127.0.0.1 or one specific address (e.g. the box's
# tailnet IP) to scope them. bin/gtd-web + bin/trips-web document the ports.
# LIFE_AGENT_WEB_HOST="127.0.0.1"
# LIFE_AGENT_TRIPS_WEB_HOST="127.0.0.1"

# The membrane shadow's engine command. PRESENCE is the enable/disable switch: unset
# means the shadow is off, and nothing else has to change to disable it.
#
# r45 measured why this line exists. The shadow stopped accruing on 2026-08-09 when the
# whole stack stopped, and never came back when the stack did on 08-17 -- because its
# only enablement was an environment variable set by hand in an interactive shell, held
# in no .env, no systemd unit, and no dotfile. A restart restored everything that was
# written down and nothing that was not. Keep it written down here.
# Give an ABSOLUTE path -- the value is shlex.split and exec'd directly, with no
# shell involved, so neither a tilde nor an environment variable is expanded.
# LIFE_AGENT_MEMBRANE_COMMAND="/usr/local/bin/proplang-host"

# Optional membrane knobs (defaults in src/life_agent/core/config.py):
#   _UTILITY      declared utility forms   (default "said@1")
#   _READ_TIMEOUT per-reply timeout seconds (default 300)
# LIFE_AGENT_MEMBRANE_UTILITY="said@1"
# LIFE_AGENT_MEMBRANE_READ_TIMEOUT="300"
